generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DJ
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum SessionStatus {
  ACTIVE
  ENDED
}

enum RequestStatus {
  PENDING
  APPROVED
  PLAYING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

model Business {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  logoUrl           String?
  primaryColor      String         @default("#ec4899")
  status            BusinessStatus @default(ACTIVE)
  maxPendingPerTable Int           @default(2)
  autoApprove       Boolean        @default(false)
  createdAt         DateTime       @default(now())

  users    User[]
  tables   Table[]
  sessions KaraokeSession[]
  requests SongRequest[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  businessId   String?
  createdAt    DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Table {
  id         String   @id @default(cuid())
  businessId String
  name       String
  active     Boolean  @default(true)
  // Token aleatorio del QR. Rotarlo revoca el QR anterior.
  qrToken    String   @unique
  createdAt  DateTime @default(now())

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requests SongRequest[]

  @@index([businessId])
}

model KaraokeSession {
  id           String        @id @default(cuid())
  businessId   String
  status       SessionStatus @default(ACTIVE)
  requestsOpen Boolean       @default(true)
  paused       Boolean       @default(false)
  // true cuando una persona pulso "Iniciar karaoke" en la TV
  tvStarted    Boolean       @default(false)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requests SongRequest[]

  @@index([businessId, status])
}

model SongRequest {
  id              String        @id @default(cuid())
  businessId      String
  tableId         String
  sessionId       String
  videoId         String
  title           String
  channel         String?
  thumbnail       String?
  durationSec     Int?
  status          RequestStatus @default(PENDING)
  position        Int
  rejectionReason String?
  requestedAt     DateTime      @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table    Table          @relation(fields: [tableId], references: [id], onDelete: Cascade)
  session  KaraokeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([businessId, sessionId, status, position])
  @@index([tableId, status])
}
