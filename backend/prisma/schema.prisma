generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DJ
}

enum SearchMode {
  KARAOKE
  ANY
}

// Por donde se buscan las canciones: API de YouTube (con cache) o Google Programmable Search
enum SearchProvider {
  YOUTUBE
  GOOGLE
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  // Se registro solo y aun no paga: no puede entrar hasta que se confirme el pago
  PENDING_PAYMENT
  // Dijo que ya pago: el super admin debe revisarlo y confirmarlo
  PAYMENT_REVIEW
}

enum SessionStatus {
  ACTIVE
  ENDED
}

enum EventType {
  QR_SCANNED
  SEARCH_PERFORMED
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_REJECTED
  PLAYBACK_STARTED
  PLAYBACK_COMPLETED
  PLAYBACK_SKIPPED
  PLAYBACK_FAILED
  FEEDBACK_SUBMITTED
}

// OFF: solo suena lo que aprueba el DJ. AUTO: si la cola queda vacia, TONO pone musica normal (no karaoke).
enum AutoDjMode {
  OFF
  AUTO
}

enum RequestStatus {
  PENDING
  APPROVED
  PLAYING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

model Business {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  // Logo del local (data URL, reducido en el navegador)
  logoUrl           String?        @db.Text
  logoAt            DateTime?
  // WhatsApp de contacto y plan elegido al registrarse (STANDARD | CUSTOM)
  phone             String?
  plan              String?
  // Hasta cuando esta pagado; al vencer se suspende solo. null = sin vencimiento
  paidUntil         DateTime?
  // Imagen que la TV muestra entre canciones (data URL, ya reducida en el navegador)
  tvBanner          String?        @db.Text
  tvBannerAt        DateTime?
  // Segundos que se muestra el aviso entre canciones (para pasar los microfonos de mesa en mesa)
  tvInterludeSec    Int            @default(8)
  // Disenos que sus mesas pueden usar; vacio = todos (los define el super admin)
  allowedExperiences String[]      @default([])
  primaryColor      String         @default("#ec4899")
  status            BusinessStatus @default(ACTIVE)
  maxPendingPerTable Int           @default(2)
  autoApprove       Boolean        @default(false)
  // KARAOKE: busca versiones karaoke. ANY: cualquier video de musica.
  searchMode        SearchMode     @default(KARAOKE)
  searchProvider    SearchProvider @default(YOUTUBE)
  autoDjMode        AutoDjMode     @default(OFF)
  // Generos que el Auto-DJ debe poner (vacio = lo mas pedido del bar)
  autoDjGenres      String[]       @default([])
  createdAt         DateTime       @default(now())

  payments Payment[]
  users    User[]
  tables   Table[]
  sessions KaraokeSession[]
  requests SongRequest[]
  events   KaraokeEvent[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  businessId   String?
  createdAt    DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resets   PasswordReset[]

  @@index([businessId])
}

model Table {
  id         String   @id @default(cuid())
  businessId String
  name       String
  active     Boolean  @default(true)
  // Token aleatorio del QR. Rotarlo revoca el QR anterior.
  qrToken    String   @unique
  // Diseno del cliente para esta mesa (id del catalogo de experiencias del frontend)
  experienceId String @default("classic")
  // Al desvincular la mesa, el cliente deja de ver lo pedido antes de esta fecha
  historyClearedAt DateTime?
  createdAt  DateTime @default(now())

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requests SongRequest[]

  @@index([businessId])
}

model KaraokeSession {
  id           String        @id @default(cuid())
  businessId   String
  status       SessionStatus @default(ACTIVE)
  requestsOpen Boolean       @default(true)
  paused       Boolean       @default(false)
  // true cuando una persona pulso "Iniciar karaoke" en la TV
  tvStarted    Boolean       @default(false)
  // Latido de la TV (se guarda en BD para sobrevivir reinicios) y posicion de la cancion actual
  tvLastSeenAt DateTime?
  positionSec  Int           @default(0)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requests SongRequest[]

  @@index([businessId, status])
}

model SongRequest {
  id              String        @id @default(cuid())
  businessId      String
  // null = cancion puesta por el Auto-DJ (no la pidio ninguna mesa)
  tableId         String?
  auto            Boolean       @default(false)
  sessionId       String
  videoId         String
  title           String
  channel         String?
  thumbnail       String?
  durationSec     Int?
  status          RequestStatus @default(PENDING)
  position        Int
  rejectionReason String?
  requestedAt     DateTime      @default(now())
  approvedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table    Table?         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  session  KaraokeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([businessId, sessionId, status, position])
  @@index([tableId, status])
}

/// Eventos con significado de negocio (no cada pulsacion). Las metricas se calculan a partir de ellos.
model KaraokeEvent {
  id         String    @id @default(cuid())
  businessId String
  sessionId  String?
  tableId    String?
  type       EventType
  occurredAt DateTime  @default(now())
  /// requestId, videoId, clientId (id anonimo del navegador), rating, etc.
  metadata   Json?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type, occurredAt])
}

/// Cache persistente de busquedas de YouTube (cada search.list cuesta 100 unidades de cuota diaria).
model SearchCache {
  key       String   @id // "KARAOKE:texto normalizado"
  results   Json
  hits      Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Pagos confirmados por el super admin (historial de suscripcion)
model Payment {
  id         String    @id @default(cuid())
  businessId String
  plan       String?
  amount     Int
  // Dias de acceso que dio este pago (0 = sin vencimiento) y hasta cuando quedo pagado
  days       Int
  paidUntil  DateTime?
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([createdAt])
}

// Codigos OTP de recuperacion de contrasena (se guarda solo el hash)
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
