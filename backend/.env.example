# Neon: pooled connection string (host con -pooler)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon: conexion directa (sin -pooler), solo para migraciones
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="cambia-esto-por-un-string-largo-y-aleatorio"
# Origenes permitidos (frontend), separados por coma
CORS_ORIGINS="http://localhost:5173"
# Clave de YouTube Data API v3 (opcional para probar: sin ella solo funciona pegar links de YouTube)
YOUTUBE_API_KEY=""
# Super admin que se crea automaticamente al arrancar si no existe
SUPERADMIN_EMAIL="admin@karaoke.local"
SUPERADMIN_PASSWORD="cambiame123"
PORT=3000
# Correo para el codigo de recuperacion de contrasena (Gmail: activa verificacion en 2 pasos y crea una "contrasena de aplicacion")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
